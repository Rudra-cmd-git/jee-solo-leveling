# Copy this file to .env.local and fill in your Supabase project values.
# Supabase Dashboard → Project Settings → API.

# Public (safe in the browser; Row Level Security protects your data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used ONLY by /api/submissions/verify to award XP.
# NEVER prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Server-only — enables AI proof verification with Claude Vision.
# Without it, submissions are stored as "pending" instead of verified.
ANTHROPIC_API_KEY=your-Anthropic-api-key

# Optional: override the verification model (default: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
